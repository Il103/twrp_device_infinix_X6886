# Device-specific init for Infinix X6886 (MT6789) - OrangeFox Recovery
# Contains: Touch, Display, Fingerprint, LED, Vibrator, Thermal, Input

on init
    # === Display backlight ===
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/max_brightness
    chmod 0644 /sys/class/leds/lcd-backlight/max_brightness
    chown system system /sys/class/leds/lcd-backlight/bl_power
    chmod 0644 /sys/class/leds/lcd-backlight/bl_power

    # === LED ===
    chown system system /sys/class/leds/red/brightness
    chmod 0666 /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness
    chmod 0666 /sys/class/leds/green/brightness
    chown system system /sys/class/leds/blue/brightness
    chmod 0666 /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/red/max_brightness
    chmod 0644 /sys/class/leds/red/max_brightness
    chown system system /sys/class/leds/green/max_brightness
    chmod 0644 /sys/class/leds/green/max_brightness
    chown system system /sys/class/leds/blue/max_brightness
    chmod 0644 /sys/class/leds/blue/max_brightness

    # === Fingerprint (Goodix) ===
    chmod 0666 /dev/goodix_fp

    # === Vibrator (regulator-based on MT6789) ===
    chown system system /sys/class/leds/vibrator/brightness
    chmod 0666 /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/activate

    # === Touch Panel (FocalTech FT3683G via Goodix touch driver) ===
    chmod 0666 /sys/kernel/tran_display/lcm_name
    chmod 0666 /sys/kernel/tran_display/lcm_hbm_state
    chmod 0666 /sys/kernel/tran_display/lcm_dimming_state
    chmod 0666 /sys/devices/platform/soc/14013000.dsi/lcm_hbm_state

    # === Thermal zones ===
    chmod 0444 /sys/devices/virtual/thermal/thermal_zone*/temp
    chmod 0444 /sys/devices/virtual/thermal/thermal_zone*/type

    # === Input devices ===
    chmod 0660 /dev/input/event0
    chmod 0660 /dev/input/event1
    chmod 0660 /dev/input/event2
    chmod 0660 /dev/input/event3

    # === GPU ===
    chmod 0666 /sys/devices/platform/soc/10000000.mali/devfreq/10000000.mali/gpu_clock
    chmod 0666 /sys/devices/platform/soc/10000000.mali/devfreq/10000000.mali/gpu_freq

    # === CPU freq scaling ===
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/scaling_min_freq

on boot
    # === Touch Panel parameters (FocalTech) ===
    chown root diag /sys/module/tpd_setting/parameters/tpd_calmat
    chown root diag /sys/module/tpd_setting/parameters/tpd_em_debounce_time
    chown root diag /sys/module/tpd_setting/parameters/tpd_mode
    chown root diag /sys/module/tpd_debug/parameters/tpd_em_log
    chown root diag /sys/module/tpd_debug/parameters/tpd_em_log_to_fs

    # === Set default backlight level ===
    write /sys/class/leds/lcd-backlight/brightness 128

    # === GPU power control ===
    write /sys/devices/platform/soc/10000000.mali/devfreq/10000000.mali/governor performance
